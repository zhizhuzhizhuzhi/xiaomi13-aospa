diff --git a/device.mk b/device.mk
index 07cf625..50bef36 100644
--- a/device.mk
+++ b/device.mk
@@ -14,13 +14,28 @@ $(call inherit-product, vendor/xiaomi/fuxi/fuxi-vendor.mk)
 PRODUCT_SOONG_NAMESPACES += \
     $(LOCAL_PATH)
 
+# Kernel-backed platform features for this device.
+PRODUCT_RELEASE_CONFIG_MAPS += $(LOCAL_PATH)/build/release/release_config_map.textproto
+
 # Overlays
 PRODUCT_PACKAGES += \
     FuxiDolby \
     FuxiFrameworks \
+    FuxiGoogleServices \
     FuxiSettings2211133C \
     FuxiSettings2211133G \
     FuxiSettingsProvider \
     FuxiSystemUI \
     FuxiWifiRes \
     FuxiWifiResMainline \
+
+# Standard AIDL face unlock (RGB convenience class).
+$(call inherit-product, vendor/milahaina/facehal/facehal.mk)
+
+# OEM workload classification is dispatched by background package/app events.
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/sysconfig/workloadclassifier.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/sysconfig/workloadclassifier.xml
+
+# Device-specific sleep statistics and ueventd rules (preserves shared rules).
+PRODUCT_PACKAGES += \
+    android.hardware.power.stats-service.fuxi
