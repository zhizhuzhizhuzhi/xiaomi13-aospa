diff --git a/BoardConfig.mk b/BoardConfig.mk
index 400edfc..a803153 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -22,3 +22,10 @@ TARGET_OTA_ASSERT_DEVICE := fuxi
 # Properties
 TARGET_ODM_PROP += $(DEVICE_PATH)/configs/properties/odm.prop
 TARGET_VENDOR_PROP += $(DEVICE_PATH)/configs/properties/vendor.prop
+
+# Only fuxi selects the stock SM8550 GNSS implementation.
+$(call soong_config_set_bool,qcom_gnss,use_sm8550_prebuilt,true)
+
+# Fuxi-only PowerStats device node access and canonical ueventd input.
+BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
+$(call soong_config_set_bool,xiaomi_fuxi,power_stats,true)
