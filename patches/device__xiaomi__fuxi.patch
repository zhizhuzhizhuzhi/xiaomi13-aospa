diff --git a/device.mk b/device.mk
index 07cf625..834d5b5 100644
--- a/device.mk
+++ b/device.mk
@@ -14,13 +14,43 @@ $(call inherit-product, vendor/xiaomi/fuxi/fuxi-vendor.mk)
 PRODUCT_SOONG_NAMESPACES += \
     $(LOCAL_PATH)
 
+# Kernel-backed platform features for this device.
+PRODUCT_RELEASE_CONFIG_MAPS += $(LOCAL_PATH)/build/release/release_config_map.textproto
+
 # Overlays
 PRODUCT_PACKAGES += \
     FuxiDolby \
     FuxiFrameworks \
+    FuxiGoogleServices \
     FuxiSettings2211133C \
     FuxiSettings2211133G \
     FuxiSettingsProvider \
     FuxiSystemUI \
     FuxiWifiRes \
     FuxiWifiResMainline \
+
+# Standard AIDL face unlock (RGB convenience class).
+$(call inherit-product, vendor/milahaina/facehal/facehal.mk)
+
+# OEM workload classification is dispatched by background package/app events.
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/sysconfig/workloadclassifier.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/sysconfig/workloadclassifier.xml
+
+# Device-specific sleep statistics and ueventd rules (preserves shared rules).
+PRODUCT_PACKAGES += \
+    android.hardware.power.stats-service.fuxi
+
+# Let games select their frame rate without a system default 60 FPS cap.
+PRODUCT_SYSTEM_PROPERTIES += ro.surface_flinger.game_default_frame_rate_override=60
+
+# Disable the default game FPS cap on boot; retain the 60 Hz fallback setting.
+PRODUCT_SYSTEM_PROPERTIES += debug.graphics.game_default_frame_rate.disabled=true
+
+# Touch sampling configuration for the existing XiaomiParts service.
+PRODUCT_PACKAGES += init.fuxi.touch.rc
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/touch/touch-polling.conf:$(TARGET_COPY_OUT_VENDOR)/etc/touch-polling.conf
+
+# Qualcomm power HAL interaction policy.
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/power/power-interaction.conf:$(TARGET_COPY_OUT_VENDOR)/etc/power-interaction.conf
