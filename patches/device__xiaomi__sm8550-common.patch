diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 2f22600..2c839fc 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -27,7 +27,8 @@ AB_OTA_PARTITIONS += \
 
 # Architecture
 TARGET_ARCH := arm64
-TARGET_ARCH_VARIANT := armv9-a
+# fuxi does not expose SVE; avoid mandatory SVE in early init and userspace.
+TARGET_ARCH_VARIANT := armv8-2a-dotprod
 TARGET_CPU_ABI := arm64-v8a
 TARGET_CPU_VARIANT := kryo785
 
@@ -65,7 +66,7 @@ DEVICE_MANIFEST_FILE += \
     $(COMMON_PATH)/configs/vintf/manifest_xiaomi.xml
 
 # Init
-TARGET_INIT_VENDOR_LIB := //$(COMMON_PATH):libinit_xiaomi_sm8550
+$(call soong_config_set,libinit,vendor_init_lib,//$(COMMON_PATH):libinit_xiaomi_sm8550)
 TARGET_RECOVERY_DEVICE_MODULES := libinit_xiaomi_sm8550
 
 # Kernel
@@ -86,9 +87,10 @@ BOARD_USES_GENERIC_KERNEL_IMAGE := true
 TARGET_HAS_GENERIC_KERNEL_HEADERS := true
 
 # Lineage Health
-TARGET_HEALTH_CHARGING_CONTROL_CHARGING_ENABLED  := 0
-TARGET_HEALTH_CHARGING_CONTROL_CHARGING_DISABLED  := 1
-TARGET_HEALTH_CHARGING_CONTROL_CHARGING_PATH := /sys/class/qcom-battery/night_charging
+# Current health HAL uses Soong configuration, rather than legacy TARGET vars.
+$(call soong_config_set,aospa_health,charging_control_charging_enabled,0)
+$(call soong_config_set,aospa_health,charging_control_charging_disabled,1)
+$(call soong_config_set,aospa_health,charging_control_charging_path,/sys/class/qcom-battery/night_charging)
 
 # Metadata
 BOARD_USES_METADATA_PARTITION := true
@@ -134,6 +136,7 @@ TARGET_SYSTEM_PROP += $(COMMON_PATH)/configs/properties/system.prop
 TARGET_VENDOR_PROP += $(COMMON_PATH)/configs/properties/vendor.prop
 
 # Recovery
+BOARD_USES_FULL_RECOVERY_IMAGE := true
 BOARD_EXCLUDE_KERNEL_FROM_RECOVERY_IMAGE := true
 TARGET_RECOVERY_FSTAB := $(COMMON_PATH)/init/fstab.qcom
 TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
@@ -157,6 +160,7 @@ SOONG_CONFIG_SENSORS_XIAOMI_USES_UDFPS_SENSOR := true
 
 # Verified Boot
 BOARD_AVB_ENABLE := true
+# AVB verification and dm-verity disabled by explicit user request.
 BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
 BOARD_MOVE_GSI_AVB_KEYS_TO_VENDOR_BOOT := true
 
@@ -198,3 +202,6 @@ SOONG_CONFIG_XIAOMI_VIBRATOR_USE_EFFECT_STREAM := true
 
 # WiFi
 include device/qcom/wlan/kalama/BoardConfigWlan.mk
+
+# Use the Skia Vulkan backend for HWUI.
+TARGET_USES_VULKAN := true
