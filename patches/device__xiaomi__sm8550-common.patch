+def allow_framework_aod_brightness(ctx, file, file_path, *args, **kwargs):
+    # Xiaomi's DAL skips nonzero brightness in stable Doze/DozeSuspend.
+    # AOSPA's framework owns the ramp; the M3 driver converts normal DBV to AOD.
+    # Branch to the existing write path, preserving the earlier pending-power
+    # check, active-panel check, return handling, ABI and all other functions.
+    original = bytes.fromhex('95 b2 46 b9 a8 06 00 51 1f 09 00 71 82 00 00 54 73 03 00 34 88 52 5c 39 04 00 00 14 13 03 00 34 88 52 5c 39 c8 02 08 36')
+    patched = bytes.fromhex('1f 00 00 14') + original[4:]
+    with open(file_path, 'rb') as stream:
