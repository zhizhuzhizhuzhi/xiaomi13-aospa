+static void FreeProperties(drmModeObjectProperties*& props, drmModePropertyRes**& info) {
+  if (info && props) {
+    for (uint32_t i = 0; i < props->count_props; ++i)
+      if (info[i]) drmModeFreeProperty(info[i]);
+  }
+  free(info);
+  info = nullptr;
+  if (props) drmModeFreeObjectProperties(props);
+  props = nullptr;
+}
+
+static void FreePlane(Plane& plane) {
+  FreeProperties(plane.props, plane.props_info);
+  if (plane.plane) drmModeFreePlane(plane.plane);
+  plane.plane = nullptr;
+}
