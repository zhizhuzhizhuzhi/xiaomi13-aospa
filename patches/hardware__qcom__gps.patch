+// Device-selected vendor implementation; generic GNSS remains the default.
+soong_config_module_type {
+    name: "qtilocation_fuxi_cc_defaults",
+    module_type: "cc_defaults",
+    config_namespace: "qcom_gnss",
+    bool_variables: ["use_sm8550_prebuilt"],
+    properties: ["installable", "shared_libs"],
+}
+qtilocation_fuxi_cc_defaults {
+    name: "qtilocation_fuxi_install_defaults",
+    soong_config_variables: {
+        use_sm8550_prebuilt: {
+            installable: false,
+            conditions_default: { installable: true },
+        },
+    },
+}
+qtilocation_fuxi_cc_defaults {
+    name: "qtilocation_fuxi_impl_defaults",
+    soong_config_variables: {
+        use_sm8550_prebuilt: {
+            shared_libs: ["android.hardware.gnss-aidl-impl-qti_sm8550"],
+            conditions_default: {
+                shared_libs: ["android.hardware.gnss-aidl-impl-qti"],
+            },
+        },
+    },
+}
