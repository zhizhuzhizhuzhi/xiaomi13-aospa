diff --git a/private/shell.te b/private/shell.te
index 5d3cabc..7b31fb0 100644
--- a/private/shell.te
+++ b/private/shell.te
@@ -217,6 +217,9 @@ get_prop(shell, vendor_security_patch_level_prop)
 # Read state of logging-related properties
 get_prop(shell, device_logging_prop)
 
+# Framework display metrics are initialized by shell app_process tools too.
+get_prop(shell, qemu_sf_lcd_density_prop)
+
 # Read state of boot reason properties
 get_prop(shell, bootloader_boot_reason_prop)
 get_prop(shell, last_boot_reason_prop)
diff --git a/private/system_server.te b/private/system_server.te
