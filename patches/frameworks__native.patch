+#include <mutex>
+#include <unordered_map>
 
 namespace android {
 
+#if defined(LIBUI_IN_VNDK) || defined(__ANDROID_VENDOR__)
+namespace {
+struct VendorBufferMonitors {
+    std::mutex mutex;
+    std::unordered_map<const GraphicBuffer*, std::unique_ptr<DependencyMonitor>> monitors;
+};
+VendorBufferMonitors& vendorBufferMonitors() {
+    // Registry lifetime covers all buffers, including static-object teardown.
+    static auto* const state = new VendorBufferMonitors;
+    return *state;
+}
+void eraseVendorBufferMonitor(const GraphicBuffer* buffer) {
+    auto& state = vendorBufferMonitors();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    state.monitors.erase(buffer);
+}
+} // namespace
+
+DependencyMonitor& GraphicBuffer::getDependencyMonitor() {
+    auto& state = vendorBufferMonitors();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    auto& monitor = state.monitors[this];
+    if (!monitor) monitor = std::make_unique<DependencyMonitor>();
+    return *monitor;
+}
+#endif
+
