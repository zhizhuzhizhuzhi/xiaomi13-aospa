+TEST_P(RefreshRateSelectorTest, vrrIdleCallbackRoutesToOptedInPolicy) {
+    if (!GetParam().enableFrameRateOverride) GTEST_SKIP();
+    for (const Fps floor : {60_Hz, 1_Hz}) {
+        std::promise<bool> result;
+        auto ready = result.get_future();
+        auto selector = createSelector(kVrrMode_120, kModeId120,
+                                      {.legacyIdleTimerTimeout = 10ms, .vrrIdleMinFps = floor});
+        selector.setIdleTimerCallbacks(
+                {.platform = {.onReset = [] {}, .onExpired = [&] { result.set_value(true); }},
+                 .vrr = {.onReset = [] {}, .onExpired = [&] { result.set_value(false); }}});
+        selector.startIdleTimer();
+        const auto status = ready.wait_for(1s);
+        selector.stopIdleTimer();
+        ASSERT_EQ(std::future_status::ready, status);
+        EXPECT_EQ(floor.getValue() < 60.f, ready.get());
+    }
