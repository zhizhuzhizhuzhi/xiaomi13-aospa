-                } else {
-                    return chgCtrlStage.STAGE_WAITING;
-                }
-            }
-            case STAGE_CONTINUE -> {
-                if (!plugged) {
-                    return chgCtrlStage.STAGE_INITIAL;
-                }
-                return chgCtrlStage.STAGE_CONTINUE;
-            }
-        }
