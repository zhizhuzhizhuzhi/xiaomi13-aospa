-    private void setDeferredKeyActionsExecutableAsync(int keyCode, long downTime) {
-        Message msg = Message.obtain(mHandler, MSG_SET_DEFERRED_KEY_ACTIONS_EXECUTABLE);
-        msg.arg1 = keyCode;
-        msg.obj = downTime;
-        msg.setAsynchronous(true);
-        msg.sendToTarget();
-    }
