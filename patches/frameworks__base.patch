+                break;
+            }
+
+            case KeyEvent.KEYCODE_SOFT_SLEEP: {
+                notifyKeyGestureCompletedOnActionUp(event,
+                        KeyGestureEvent.KEY_GESTURE_TYPE_SLEEP);
