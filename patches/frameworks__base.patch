-
-    private boolean onStage(chgCtrlStage stage) {
-        switch (stage) {
-            case STAGE_NONE -> {
-                setChargingEnabled(true);
-                return false;
-            }
-            case STAGE_INITIAL, STAGE_CONTINUE -> {
-                return setChargingEnabled(true);
-            }
-            case STAGE_WAITING -> {
