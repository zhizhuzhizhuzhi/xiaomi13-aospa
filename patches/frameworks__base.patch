+    private void showBrightnessOverrideToast() {
+        Toast.makeText(
+                mContext,
+                UiThread.get().getLooper(),
+                mContext.getString(R.string.brightness_unable_adjust_msg),
+                Toast.LENGTH_SHORT)
+                .show();
+    }
