+                    msg.sendToTarget();
+                    notifyKeyGestureCompleted(event,
+                            KeyGestureEvent.KEY_GESTURE_TYPE_LAUNCH_VOICE_ASSISTANT);
+                }
+                result &= ~ACTION_PASS_TO_USER;
