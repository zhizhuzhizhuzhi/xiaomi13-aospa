+    @Override
+    public void getBondedDeviceInfoAsync(AttributionSource source,
+            IBluetoothBondedDevicesCallback callback) throws RemoteException {
+        requireNonNull(callback);
+        // Alias delivery requires the active-user check; profile group IDs are privileged.
+        var service = getServiceAndEnforceCallerUserAndConnectAllowPcc(
+                source, "getBondedDeviceInfoAsync");
+        if (service == null) {
+            callback.onResult(Collections.emptyList());
+            return;
+        }
+        service.enforceCallingOrSelfPermission(BLUETOOTH_PRIVILEGED, null);
+        var a2dp = service.getA2dpService();
+        var hearingAid = service.getHearingAidService();
+        var leAudio = service.getLeAudioService();
+        List<BluetoothDevice> a2dpDevices = a2dp.isPresent()
+                ? a2dp.get().getConnectedDevices() : Collections.emptyList();
+        List<BluetoothDevice> hearingAidDevices = hearingAid.isPresent()
+                ? hearingAid.get().getConnectedDevices() : Collections.emptyList();
+        List<BluetoothDevice> leAudioDevices = leAudio.isPresent()
+                ? leAudio.get().getConnectedDevices() : Collections.emptyList();
+        List<BluetoothBondedDeviceInfo> result = new ArrayList<>();
+        for (BluetoothDevice device : service.getBondedDevices()) {
+            List<Integer> profiles = new ArrayList<>();
+            if (a2dpDevices.contains(device)) profiles.add(BluetoothProfile.A2DP);
+            boolean hasHearingAid = hearingAidDevices.contains(device);
+            boolean hasLeAudio = leAudioDevices.contains(device);
+            if (hasHearingAid) profiles.add(BluetoothProfile.HEARING_AID);
+            if (hasLeAudio) profiles.add(BluetoothProfile.LE_AUDIO);
+            DeviceProperties properties = service.getRemoteDevices().getDeviceProperties(device);
+            String alias = properties == null ? null : properties.getAlias();
+            // Match BluetoothDevice.getAlias(): normalize control characters for display.
+            if (alias != null) alias = alias.replace('\t', ' ').replace('\n', ' ').replace('\r', ' ');
+            result.add(new BluetoothBondedDeviceInfo(device,
+                    alias, service.isConnected(device),
+                    profiles.stream().mapToInt(Integer::intValue).toArray(),
+                    hasHearingAid ? hearingAid.get().getHiSyncId(device)
+                            : BluetoothHearingAid.HI_SYNC_ID_INVALID,
+                    hasLeAudio ? leAudio.get().getGroupId(device)
+                            : BluetoothLeAudio.GROUP_ID_INVALID));
+        }
+        callback.onResult(List.copyOf(result));
+    }
