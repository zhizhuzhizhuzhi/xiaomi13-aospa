diff --git a/generic/private/system_server.te b/generic/private/system_server.te
index ceb5ae9..4e40c29 100644
--- a/generic/private/system_server.te
+++ b/generic/private/system_server.te
@@ -64,9 +64,8 @@ binder_call(system_server, vendor_wfdservice);
 userdebug_or_eng(`
   get_prop(system_server, vendor_wfd_sys_debug_prop)
 ')
-userdebug_or_eng(`
-  get_prop(system_server, vendor_wfd_sys_prop)
-')
+# WifiDisplayController reads the functional WFD R2 setting on user builds.
+get_prop(system_server, vendor_wfd_sys_prop)
 # Allow system server to access fst,wigig system properties
 set_prop(system_server, vendor_wigig_core_prop)
 set_prop(system_server, vendor_fst_prop)
@@ -94,3 +93,6 @@ get_prop(system_server, vendor_persist_rcs_prop)
 get_prop(system_server, vendor_persist_ntn_prop)
