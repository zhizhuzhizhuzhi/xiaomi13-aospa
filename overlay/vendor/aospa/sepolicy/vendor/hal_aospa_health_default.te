type hal_aospa_health_default, domain;
hal_server_domain(hal_aospa_health_default, hal_aospa_health)

type hal_aospa_health_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_aospa_health_default)

binder_call(hal_aospa_health_default, servicemanager);

# Allow AospaHealth HAL to write to battery and usb sysfs node
allow hal_aospa_health_default vendor_sysfs_battery_supply:dir search;
allow hal_aospa_health_default vendor_sysfs_battery_supply:file rw_file_perms;
allow hal_aospa_health_default vendor_sysfs_usb_supply:dir search;
allow hal_aospa_health_default vendor_sysfs_usb_supply:file rw_file_perms;
