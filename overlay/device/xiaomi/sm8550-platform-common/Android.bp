soong_namespace {}

aconfig_values {
    name: "aconfig_values-sm8550_window_lifecycle",
    package: "com.android.window.flags",
    srcs: ["build/release/aconfig/transition_surface_cleanup.textproto"],
}
aconfig_value_set {
    name: "aconfig_value_set-sm8550_window_lifecycle",
    values: ["aconfig_values-sm8550_window_lifecycle"],
}

aconfig_values {
    name: "aconfig_values-sm8550_bluetooth_async_snapshot",
    package: "com.android.bluetooth.flags",
    srcs: [
        "build/release/aconfig/bluetooth_async_snapshot.textproto",
        "build/release/aconfig/bluetooth_async_broadcast_support.textproto",
        "build/release/aconfig/bluetooth_async_bonded_snapshot.textproto",
    ],
}
aconfig_value_set {
    name: "aconfig_value_set-sm8550_bluetooth_async_snapshot",
    values: ["aconfig_values-sm8550_bluetooth_async_snapshot"],
}

// Shared Xiaomi SM8550 stock QESDK implementations.
cc_prebuilt_library_shared {
	name: "libqesdk2_0",
	owner: "xiaomi",
	strip: {
		none: true,
	},
	target: {
		android_arm: {
			srcs: ["proprietary/vendor/lib/libqesdk2_0.so"],
			shared_libs: ["liblog", "libjsoncpp", "libcutils", "libbase", "libutils", "libhidlbase", "libcrypto", "libnl", "libc++", "libc", "libm", "libdl", ],
		},
		android_arm64: {
			srcs: ["proprietary/vendor/lib64/libqesdk2_0.so"],
			shared_libs: ["liblog", "libjsoncpp", "libcutils", "libbase", "libutils", "libhidlbase", "libcrypto", "libnl", "libc++", "libc", "libm", "libdl", ],
		},
	},
	compile_multilib: "both",
	prefer: true,
	soc_specific: true,
}

cc_prebuilt_library_shared {
	name: "libqesdk_manager",
	owner: "xiaomi",
	strip: {
		none: true,
	},
	target: {
		android_arm: {
			srcs: ["proprietary/vendor/lib/libqesdk_manager.so"],
			shared_libs: ["libutils", "libcutils", "liblog", "libcrypto", "libjsoncpp", "libminkdescriptor", "libminksocket_vendor", "libqcbor", "libbinder", "libbinder_ndk", "vendor.qti.qesdsys-V3-ndk", "libprotobuf-cpp-lite-3.9.1-vendorcompat", "libc++", "libc", "libm", "libdl", ],
		},
		android_arm64: {
			srcs: ["proprietary/vendor/lib64/libqesdk_manager.so"],
			shared_libs: ["libutils", "libcutils", "liblog", "libcrypto", "libjsoncpp", "libminkdescriptor", "libminksocket_vendor", "libqcbor", "libbinder", "libbinder_ndk", "vendor.qti.qesdsys-V3-ndk", "libprotobuf-cpp-lite-3.9.1-vendorcompat", "libc++", "libc", "libm", "libdl", ],
		},
	},
	compile_multilib: "both",
	prefer: true,
	soc_specific: true,
}

cc_prebuilt_library_shared {
	name: "vendor.qti.qesdsys-V3-ndk",
