# Keep standard platform-app behavior, but isolate device-specific HAL grants.
typeattribute fuxi_camera_app coredomain;
app_domain(fuxi_camera_app)
net_domain(fuxi_camera_app)
bluetooth_domain(fuxi_camera_app)
platform_app_domain(fuxi_camera_app)
typeattribute fuxi_soter_app coredomain;
app_domain(fuxi_soter_app)
net_domain(fuxi_soter_app)
bluetooth_domain(fuxi_soter_app)
platform_app_domain(fuxi_soter_app)
