# Only the stock platform-signed camera may call Xiaomi MIVI directly.
hal_client_domain(fuxi_camera_app, vendor_hal_camerapostproc_xiaomi)
binder_call(fuxi_camera_app, hal_camera_default)
allow fuxi_camera_app hal_camera_default:fd use;
get_prop(fuxi_camera_app, vendor_camera_prop)
get_prop(fuxi_camera_app, vendor_fp_prop)
get_prop(fuxi_camera_app, vendor_display_prop)
get_prop(fuxi_camera_app, vendor_panel_info_prop)
# Only the platform-signed Soter frontend receives these Soter/UDFPS grants.
hal_client_domain(fuxi_soter_app, vendor_hal_soter)
get_prop(fuxi_soter_app, vendor_fp_prop)
