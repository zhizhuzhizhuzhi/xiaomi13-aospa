type vendor_fuxi_sleep_stats_device, dev_type;
allow hal_power_stats_default vendor_fuxi_sleep_stats_device:chr_file { open read getattr ioctl };
# Only read requests from subsystem_sleep_stats.c; exclude the DDR array ioctl.
allowxperm hal_power_stats_default vendor_fuxi_sleep_stats_device:chr_file ioctl {
    0x9d00 0x9d01 0x9d03 0x9d04 0x9d05 0x9d06 0x9d07
    0x9d08 0x9d09 0x9d0a 0x9d0b 0x9d0c
};
